# Пример файла overrides.yml для Global ID Registry
# Используется для ручной коррекции конфликтов при дедупликации

# Переопределения для организаций
org_overrides:
  # Пример 1: Фиксация gid для организации по ключу ИНН
  - key: ["ORG", "INN", "7723537840"]
    gid: "58a49494-b44e-5b2f-9263-0ce9005f10e3"
    comment: "ДНК-Технология - фиксированный gid для основного офиса"
  
  # Пример 2: Разрешение конфликта NAME_CITY
  - key: ["ORG", "NAME_CITY", "агрохим", "казань"]
    gid: "25eab71a-64f5-5bdb-a3e6-0f9667ab4b3d"
    comment: "Агрохим Казань - разделение с Агрохим Москва"
  
  # Пример 3: Слияние дубликатов через общий gid
  - key: ["ORG", "DOMAIN", "dna-technology.ru"]
    gid: "58a49494-b44e-5b2f-9263-0ce9005f10e3"
    comment: "Объединение с основной записью ДНК-Технология"

# Переопределения для контактов
contact_overrides:
  # Пример 1: Фиксация gid для персонального контакта
  - key: ["CONTACT", "EMAIL", "58a49494-b44e-5b2f-9263-0ce9005f10e3", "m.gogoleva@dna-technology.ru"]
    gid: "a3ac53de-6e12-5e5e-8cbc-2a8a1714c631"
    comment: "Гоголева Мария - основной менеджер"
  
  # Пример 2: Объединение контакта по телефону
  - key: ["CONTACT", "PHONE", "58a49494-b44e-5b2f-9263-0ce9005f10e3", "+79951293976"]
    gid: "d5f49e0f-c844-59e3-82ef-6b4b2ccf93a3"
    comment: "Воронова Светлана - региональный представитель СФО"

# Инструкция по использованию:
# 1. Скопируйте этот файл как 'overrides.yml' в папку src/registry/
# 2. Добавьте нужные переопределения в соответствующие секции
# 3. Формат ключа зависит от типа:
#    - Организации: ["ORG", тип_ключа, значение(я)]
#      Типы: "INN", "DOMAIN", "NAME_CITY", "EMAIL_DOMAIN", "FALLBACK"
#    - Контакты: ["CONTACT", тип_ключа, org_gid, значение(я)]
#      Типы: "EMAIL", "PHONE", "NAME_POSITION"
# 4. gid должен быть валидным UUID или существующим gid из реестра
# 5. comment - необязательное поле для пояснения причины override

# ВАЖНО:
# - При конфликте между override и существующей записью приоритет у override
# - Конфликты фиксируются в postprocessing_metadata.gid.conflicts
# - Для просмотра текущих gid используйте файлы:
#   * src/registry/organizations.jsonl
#   * src/registry/contacts.jsonl