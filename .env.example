# ========================================
# DaData API для обогащения ИНН организаций
# ========================================
# Включить/выключить DaData enrichment
# true - использовать DaData для поиска ИНН по названию организации
# false - отключить DaData (не будет предупреждений в логах)
DADATA_ENABLED=false

# API ключи DaData (получить на https://dadata.ru)
# Бесплатный тариф: 10,000 запросов/день
# Оставьте пустыми если DADATA_ENABLED=false
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Пример с реальными ключами (для справки):
# DADATA_API_KEY=
# DADATA_SECRET_KEY=
# ========================================
# Другие переменные окружения
# ========================================
# IMAP_SERVER=your_imap_server
# IMAP_USER=your_username
# IMAP_PASSWORD=your_password
# OPENROUTER_API_KEY=your_openrouter_key