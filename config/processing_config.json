{
  "processing": {
    "skip_processed": true,
    "force_reprocess": false,
    "max_parallel": 3
  },
  "output": {
    "save_extracted_texts": true,
    "generate_html_reports": true,
    "save_combined_texts": true
  },
  "chunking": {
    "use_tokens": true,
    "max_tokens_per_chunk": 12000,
    "overlap_tokens": 1200,
    "max_chunks_per_text": 15,
    "encoding_model": "cl100k_base",
    "auto_adjust_chunk_size": true,
    "min_chunk_size": 3000,
    "max_chunk_size": 16000,
    "very_large_text_threshold": 500000,
    "very_large_max_tokens_per_chunk": 20000,
    "very_large_overlap_tokens": 2000,
    "very_large_max_chunks": 100,
    "memory_optimization": true,
    "progressive_chunking": true,
    "smart_boundary_detection": true,
    "chunk_alert_threshold": 30,
    "chunk_abort_threshold": 80,
    "allow_chunk_abort": true,
    "enable_async_processing": true,
    "max_concurrent_chunks": 3,
    "api_rate_limit_delay": 1.0,
